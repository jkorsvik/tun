#!/bin/sh
# Copyright (C) 2026 The Tún authors (see AUTHORS.md)
# This file is part of Tún. Licence: GNU AGPL v3 or later, see LICENSE.
# SPDX-License-Identifier: AGPL-3.0-or-later
# pre-commit — run the tenant-constraint gates before a commit is allowed.
#
# Tracked in the repo, not copied into .git/hooks. Enable it once per clone with:
#
#     python3 setup.py --hooks        (sets git config core.hooksPath tools/hooks)
#
# Why this exists
# ---------------
# Rows 24 and 26 of docs/01-tenant-constraints.md were measured against the real tenant,
# written down, and then broken by four shipped files. The checks that would have
# caught them already existed in tools/verify_standalone_core.py. Nothing ran them. This
# is the thing that runs them.
#
# It is NOT a substitute for CI. CI (.github/workflows/gates.yml) runs every gate on each
# pull request; this hook stops a mistake earlier, before the commit, and protects only
# clones that ran `setup.py --hooks`. Treat a green commit as evidence about this machine,
# not about the repo.
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

PY=$(command -v python3 || command -v python || true)
if [ -z "$PY" ]; then
    echo "pre-commit: no python3 on PATH — cannot run the gates." >&2
    echo "            Install Python 3.9+, or bypass with 'git commit --no-verify'" >&2
    echo "            and run 'python3 tools/check_tree.py' before you push." >&2
    exit 1
fi

# Nothing reaches the integration branch except through a pull request.
#
# This is not a style preference; it has already gone wrong twice. Commit 0517006
# ("Untrack work/ and uv.lock — they were swept onto main by mistake") is one, and a
# parallel session's scratch directory was once committed and merged from a shared
# clone. Both were `git add` plus a commit on the wrong branch, and neither was caught
# by anything until after the merge.
#
# The integration branch is DISCOVERED from the remote, not hardcoded, so this keeps
# working in a fork, a rename, or a repo whose default branch is `master` or `dev`.
# When origin/HEAD is not set locally, fall back to `main` rather than to "allow".
PROTECTED=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null \
            | sed 's|^origin/||')
[ -n "${PROTECTED:-}" ] || PROTECTED=main
BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "(detached)")

if [ "$BRANCH" = "$PROTECTED" ]; then
    echo "pre-commit: BLOCKED — this is a direct commit to '$PROTECTED'." >&2
    echo >&2
    echo "  Nothing reaches '$PROTECTED' except through a pull request." >&2
    echo "  Move the work onto a branch, keeping the staged changes:" >&2
    echo >&2
    echo "      git switch -c <type>/<short-description>" >&2
    echo "      git commit" >&2
    echo >&2
    echo "  Already committed here by mistake? The commit is still local:" >&2
    echo "      git branch <type>/<short-description>   # save it" >&2
    echo "      git reset --hard origin/$PROTECTED      # DISCARDS local $PROTECTED commits" >&2
    echo >&2
    echo "  'git commit --no-verify' bypasses this. '$PROTECTED' is not protected on the" >&2
    echo "  forge, so a bypass here is the only thing between a typo and a direct push." >&2
    exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
fail=0

run() {
    label=$1
    shift
    # Keep the hook quiet on success. A noisy hook trains people into --no-verify.
    if out=$("$@" 2>&1); then
        printf '  ok   %s\n' "$label"
    else
        printf '  FAIL %s\n' "$label"
        printf '%s\n' "$out" | sed 's/^/       /'
        fail=1
    fi
}

echo "pre-commit: tenant-constraint gates"

# --- always: fast (well under a second) and covers every tracked file -----------------
# check_tree.py runs the real-data gate as well as the row gates, so there is one command
# here rather than two that could drift apart.
run "tree gates (rows 24/25/26, data, core/plugin boundary)" \
    "$PY" tools/check_tree.py --quiet

run "gate unit tests + mutation pass" \
    "$PY" tests/test_row_24_26_checks.py
run "real-data gate tests + mutation pass" \
    "$PY" tests/test_no_real_data_gate.py
run "core/plugin boundary tests" \
    "$PY" tests/test_core_boundary_gate.py
# The hooks check themselves: pre-push once shipped without its execute bit, which git
# ignores in silence. Asserting the mode in the index is the only reliable signal.
run "hooks are live (executable, and still refusing)" \
    "$PY" tests/test_hooks_are_live.py
run "token contract (slots, discovery, load order)" \
    "$PY" tests/test_token_contract.py
run "licence headers (the Exception covers only files that state it)" \
    "$PY" tests/test_licence_headers.py
run "findings index (every row still points at its text)" \
    "$PY" tests/test_findings_index.py
run "builder provenance (no OS user name, documented commands pass a role)" \
    "$PY" tests/test_builder_provenance.py
run "cube reproducibility (same data, same bytes, any Python build)" \
    "$PY" tests/test_cube_reproducible.py
# A strict harness drops a skill whose frontmatter is not strict YAML, in silence.
run "skill frontmatter (Agent Skills spec, strict YAML)" \
    "$PY" tests/test_skill_frontmatter.py
# Every built example must carry the Origin Notice, or the Exception does not cover it.
run "origin notice (every built example names Tún and tun.community)" \
    "$PY" tests/test_origin_notice.py
run "export-clean gate tests (denylist, manifests, binaries)" \
    "$PY" tests/test_export_clean_gate.py

# --- only when their inputs are staged, to keep the hook worth running ----------------
if printf '%s\n' "$STAGED" | grep -q '^tools/'; then
    run "verify-tool guards (tools/ changed)" "$PY" tests/test_verify_gate_browser.py
fi
if printf '%s\n' "$STAGED" | grep -qE '^(tools/|templates/)'; then
    run "feedback log + link (tools/ or templates/ changed)" "$PY" tests/test_tun_feedback.py
fi
if printf '%s\n' "$STAGED" | grep -qE '^(setup\.py|skills/)'; then
    run "skill installer (setup.py or skills/ changed)" "$PY" tests/test_skill_links.py
    run "setup.py browser probe (setup.py or skills/ changed)" \
        "$PY" tests/test_setup_browser_probe.py
fi

# --- state the gap rather than paper over it ------------------------------------------
# check_tree.py reads the working tree, not the staged blobs. If an .html differs between
# the two — a partial `git add -p`, say — then what passed here is not what is being
# committed. Say so out loud instead of implying a guarantee the check cannot give.
DRIFT=$(git diff --name-only -- '*.html')
if [ -n "$DRIFT" ]; then
    echo "  note the gates read the working tree, and these .html files differ from what"
    echo "       you staged, so the commit was not what was checked:"
    printf '%s\n' "$DRIFT" | sed 's/^/         /'
fi

if [ "$fail" -ne 0 ]; then
    cat >&2 <<'MSG'

pre-commit: BLOCKED — a gate failed.

  Fix the file, or if the failure is genuinely accepted debt, add it to KNOWN_DEBT
  in tools/tree_scan.py with a reason and an issue reference.

  'git commit --no-verify' bypasses this. It is a real option: CI still checks the
  pull request, but only after the push.
MSG
    exit 1
fi

exit 0
