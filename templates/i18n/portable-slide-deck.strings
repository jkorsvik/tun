# Strings for templates/portable-slide-deck.html and tools/build_slide_deck.py.
# Format: see tools/i18n.py. nb is what the starter deck said before --lang existed.
# s1_* to s3_*, card_* and sec_* are the three sample slides: replace them with your own.

[nb]
html_lang = nb
title = Portable presentasjon
c_wrap_kind = Norwegian compound word
c_wrap_a = a 34-character real word ("Trygde-
c_wrap_b = avgiftsberegningsforskriften")
js_warning = Begrenset forhåndsvisning: Lagre filen og åpne den fra Filer eller Nedlastinger i en nettleser for navigasjon og fullskjerm.
sec_start = Start
sec_explain = Forklaring
sec_end = Avslutning
s1_eyebrow = Organisasjon · måned 2026
s1_h1 = Én tydelig påstand per lysbilde.
s1_p = Denne filen virker lokalt, uten server eller nettverk.
s2_eyebrow = Det viktigste først
s2_h2 = Bruk innhold som kan leses på en liten skjerm
card_1 = Én idé per lysbilde
card_2 = Minste berøringsflate
card_3 = Eksterne avhengigheter
s3_eyebrow = Neste steg
s3_h2 = Bytt ut eksemplene og kjør verifikasjonen.
s3_p = Behold kontrollene, fullskjermkontrollen og mobilreglene.
controls_label = Presentasjonskontroller
prev = Forrige lysbilde
next = Neste lysbilde
fs_enter = Vis i fullskjerm
fs_exit = Avslutt fullskjerm
fs_label = Fullskjerm
fs_exit_short = Avslutt
msg_unsupported = Nettleseren støtter ikke fullskjerm for HTML. Presentasjonen virker fortsatt i nettleservinduet.
msg_refused = Nettleseren avslo fullskjerm. Presentasjonen virker fortsatt i nettleservinduet.
default_section = Lysbilde

