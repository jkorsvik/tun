# Cohort grid: one row per cohort, one column per period since the cohort started.
# A value goes into HTML, so an `en` value never holds a quote, a backslash or a backtick.
[nb]
html_lang = nb
period_month = måned
period_week = uke
none = ingen
sub_line = {cohorts} kohorter, {entities} {word} i alt
blank_rows = {n} rad(er) uten {entity} ble hoppet over
col_cohort = Kohort
col_size = {n} {word}
word_one = person
word_other = personer
head_notes = Slik er kohortene regnet ut
footer_a = Tallene er hentet fra uttrekket og regnet ut da filen ble laget. Ingen ting oppdateres av seg selv.
footer_b = En selvstendig fil: ingen server, ingen nettverk, ingen lisens.
footer_built = Bygget
caption_intro = Hver rad er de som hadde sin første aktivitet i perioden lengst til venstre. +1 er én periode senere, +2 to perioder senere.
scroll_hint = Dra sidelengs for å se alle periodene.
caption_future = En skravert rute betyr at perioden ikke har skjedd ennå for kohorten, ikke at ingen kom tilbake.
band_0 = 0 til 9 %
band_1 = 10 til 24 %
band_2 = 25 til 49 %
band_3 = 50 til 74 %
band_4 = 75 % eller mer
band_future = Ikke mulig ennå
legend_head = Andel av kohorten som er aktiv
note_lead = Den mest tallrike kohorten er {cohort} med {size} {word}. Av dem var {k1} tilbake i periode 1, som er {k1p} %.
note_none = Ingen kohort har rader i mer enn én periode, så det finnes ingen gjenkjøp å vise.
meta_1 = Kohorten er perioden for den første datoen til hver {entity}. En som er aktiv i to perioder, teller i begge, men bare én gang per periode.
meta_2 = Andelen er antall personer delt på kohortens egen størrelse, ikke på alle i filen.
meta_3 = Kolonnen +0 er kohortens størrelse. Den er lik per definisjon, ikke et funn.
meta_4 = Ruter nede til høyre mangler fordi perioden ikke har skjedd ennå. De er skravert, ikke satt til null.
meta_5 = Kohorter under {mincohort} {word} er ikke tegnet. De er {smalllist}.
meta_6 = Perioden er {period}. Datoer som ikke kunne leses, stoppet bygget.
[en]
scroll_hint = Drag sideways to see every period.
html_lang = en
period_month = month
period_week = week
none = none
sub_line = {cohorts} cohorts, {entities} {word} in all
blank_rows = {n} row(s) with no id were skipped
col_cohort = Cohort
col_size = {n} {word}
word_one = person
word_other = people
head_notes = How the cohorts are derived
footer_a = The figures come from the extract and were worked out when the file was built. Nothing updates by itself.
footer_b = One self-contained file: no server, no network, no licence.
footer_built = Built
caption_intro = Each row is the people whose first activity was in the period on the left. +1 is one period later, +2 is two.
caption_future = A hatched cell means the period has not happened yet for that cohort, not that nobody came back.
band_0 = 0 to 9 %
band_1 = 10 to 24 %
band_2 = 25 to 49 %
band_3 = 50 to 74 %
band_4 = 75 % or more
band_future = Not possible yet
legend_head = Share of the cohort still active
note_lead = The largest cohort is {cohort} with {size} {word}. Of them {k1} came back in period 1, which is {k1p} %.
note_none = No cohort has rows in more than one period, so there is no retention to show.
meta_1 = The cohort is the period of each {entity} first date. Someone active in two periods counts in both, but only once per period.
meta_2 = The share is the number of people divided by that cohort own size, not by everyone in the file.
meta_3 = Column +0 is the size of the cohort. It is equal by definition, not a finding.
meta_4 = Cells at the lower right are missing because the period has not happened yet. They are hatched, never set to zero.
meta_5 = Cohorts under {mincohort} {word} are not drawn. They are {smalllist}.
meta_6 = The period is {period}. A date that could not be read stopped the build.
