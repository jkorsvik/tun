[en]
html_lang = en
sub_line = {count} steps in one declared workflow. Drag to rotate, select a step to read more.
caption = A spatial projection of the steps in the table. The order comes from the rows, not from the distance between the points.
summary = This is a view of a declared sequence, not a simulation. The table below carries every step, description and coordinate.
note_shape = A three-dimensional view fits when space itself helps the reader see the relationship. Use a process diagram when branches, ownership or decisions are the point.
note_interaction = Drag the picture to rotate it. Select a step with a mouse, touch or keyboard. There is no automatic movement.
note_fallback = Without WebGL or JavaScript, a static projection and the full table remain. The file makes no network requests.
head_steps = The steps and coordinates
table_caption = Every fact in the spatial view, in the same order as the data file.
col_step = Step
col_title = Name
col_description = Description
col_x = X
col_y = Y
col_z = Z
source_line = Source: {name} · {count} steps
footer_a = The coordinates are a display agreement. They do not measure duration, cost, value or progress.
footer_b = This file shows one declared sequence. It does not discover or execute the process.
footer_built = Built
svg_title = Static projection of the workflow
svg_desc = {count} steps in the declared order. The full description is in the table.
drag_hint = Drag to rotate · select a step
live_label = Spatial projection
